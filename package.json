{
  "name": "@peterchijioke/marketplace-w9-compliance",
  "version": "1.0.6",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterchijioke/marketplace-w9-compliance.git"
  },
  "homepage": "https://github.com/peterchijioke/marketplace-w9-compliance#readme",
  "bugs": {
    "url": "https://github.com/peterchijioke/marketplace-w9-compliance/issues"
  },
  "description": "Turnkey IRS Form W-9 collection, AES-256-GCM TIN encryption, Avalara Track1099 integration, and payout compliance guards for marketplaces.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "prepublishOnly": "npm run test && npm run build",
    "prepack": "cp README.md .README.md.bak && cp README.npm.md README.md",
    "postpack": "test -f .README.md.bak && mv .README.md.bak README.md || true"
  },
  "keywords": [
    "w9",
    "1099",
    "track1099",
    "avalara",
    "marketplace",
    "tax-compliance",
    "tin-validation",
    "tin-encryption",
    "irs-form-w9",
    "stripe-connect"
  ],
  "author": "Peter Chukwu",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
